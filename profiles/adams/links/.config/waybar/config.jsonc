{
  "layer": "top",
	"position": "top",
	"height": 34,
	"reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window", "clock"],
  "modules-right": ["memory", "cpu", "bluetooth", "pulseaudio", "network", "battery"],
	"pulseaudio": {
		"format": "<span size='large'>{icon}</span>",
		"format-icons": ["", "", "", ""],
		"format-muted": "",
		"headphone": ""
	},
	"bluetooth": {
		"format-off": "<span size='large'>󰂲</span>",
		"format-on": "<span size='large'></span>",
		"format-connected": "<span size='large'>󰂱</span>",
		"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
	},
	"cpu": {
		"interval": 60,
		"format": "{usage}%<span size='medium'></span>"
	},
	"network": {
		"format-wifi": "<span size='large'>{icon}</span>",
		"tooltip-format": "{essid} ({signalStrength}%) {icon}",
		"format-icons": ["󰤟","󰤢","󰤥","󰤨"],
		"format-disconnected": "󰤫"
	},
  "clock": {
		"format": "{:%H:%M}",
		"tooltip-format": "{:%d/%m/%y %H:%M}",
  },
  "battery": {
    "format": "{capacity}%<span size='large'>{icon}</span>",
		"format-icons": {
			"default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
		}
  },
	"memory": {
		"interval": 60,
		"format": "{}%<span size='medium'></span>",
		"tooltip": "{used:0.1f}G/{total:0.1f}G <span size='medium'></span>"
	}
}
