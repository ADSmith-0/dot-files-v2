{
  "layer": "top",
	"position": "top",
	"height": 30,
	"reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["pulseaudio", "clock", "bluetooth", "network", "cpu", "battery"],
	"pulseaudio": {
		"format": "{volume}% {icon}",
		"format-icons": ["", "", "", ""],
		"format-muted": "",
		"headphone": ""
	},
	"cpu": {
		"format": "{usage}% "
	},
	"network": {
		"format-wifi": "({signalStrength}%) {icon}",
		"tooltip-format": "{essid} ({signalStrength}%) {icon}",
		"format-icons": ["󰤟","󰤢","󰤥","󰤨"],
		"format-disconnected": "󰤫"
	},
  "clock": {
		"format": "{:%H:%M}",
		"tooltip-format": "{:%d/%m/%y %H:%M}",
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""]
  }
}
