{
  "layer": "top",
	"position": "top",
	"height": 45,
	"reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["memory", "cpu", "bluetooth", "pulseaudio", "network", "battery", "custom/pacman", "custom/power"],
	"wlr/taskbar": {
		"format": "{icon}",
		"icon-size": 18,
		"icon-theme": "candy-icons",
		"tooltip-format": "{title}",
		"on-click": "activate",
		"on-click-middle": "close",
		"active-first": true,
	},
	"hyprland/workspaces": {
		"format": "<span size='x-large'>{icon}</span>",
		"format-icons": {
			// "1": "󰀫",
			// "2": "󰂡",
			// "3": "󰏿",
			// "4": "󰏉",
			"1": "󰪀",
			"2": "󰪁",
			"3": "󰪈",
			"4": "󰪃",
		},
		"tooltip": false,
		"enable-bar-scroll": true,
		"persistent-workspaces": {
			"*": 4, // 4 workspaces by default on every monitor
		},
		"persistent-only": true,
	},
	"clock": {
		"format": "<span size='large'></span> {:%H:%M   <span size='large'>󰃭</span> %d %b}",
	},
	"memory": {
		"interval": 60,
		"format": "{}% <span size='medium'></span>",
		"tooltip-format": "{used:0.1f}G/{total:0.1f}G <span size='medium'></span>"
	},
	"cpu": {
		"interval": 60,
		"format": "{usage}% <span size='medium'></span>"
	},
	"pulseaudio": {
		"format": "<span size='large'>{icon}</span>",
		"format-icons": ["", "", "", ""],
		"format-muted": "",
		"tooltip-format": "{volume}% <span size='large'>{icon}</span>",
		"headphone": ""
	},
	"bluetooth": {
		"format-off": "<span size='large'>󰂲</span>",
		"format-on": "<span size='large'></span>",
		"format-connected": "<span size='large'>󰂱</span>",
		"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
	},
	"network": {
		"format-wifi": "<span size='large'>{icon}</span>",
		"tooltip-format": "{essid} ({signalStrength}%) {icon}",
		"format-icons": ["󰤟","󰤢","󰤥","󰤨"],
		"format-disconnected": "󰤫"
	},
  "battery": {
    "format": "<span size='x-large'>{icon}</span>",
		"format-icons": {
			"default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
		},
		"tooltip-format": "Capacity: {capacity}%\n{timeTo}",
		"states": {
			"below5": 5,
			"below20": 20,
			"below40": 40,
			"below60": 60,
			"below80": 80,
			"above80": 100,
		}
  },
	//alternate
	"custom/pacman": {
		"format": "{} ",
		// "interval": 3600,                     // every hour
		// "exec": "checkupdates | wc -l",       // # of updates
		// "exec-if": "exit 0",                  // always run; consider advanced run conditions
		// "on-click": "termite -e 'sudo pacman -Syu'; pkill -SIGRTMIN+8 waybar", // update system
		// "signal": 8
	},
	"custom/power": {
		"format" : "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "~/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown now",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate",
		},
	}
}
