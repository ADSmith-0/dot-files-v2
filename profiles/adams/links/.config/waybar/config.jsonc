{
  "layer": "top",
	"position": "top",
	"height": 40,
	"reload_style_on_change": true,
  "modules-left": ["wlr/taskbar", "hyprland/window"],
  "modules-center": ["hyprland/workspaces", "clock"],
  "modules-right": ["memory", "cpu", "bluetooth", "pulseaudio", "network", "battery"],
	"wlr/taskbar": {
		"format": "{icon}",
		"icon-size": 18,
		"icon-theme": "candy-icons",
		"tooltip-format": "{title}",
		"on-click": "activate",
		"on-click-middle": "close",
		"squash-list": [
			"*"
		]
	},
	"hyprland/window": {
		"max-length": 25,
		"format": "{}",
		"icon": true,
		"icon-size": 18,
	},
	"hyprland/workspaces": {
		"format": "<span size='x-large'>{icon}</span>",
		"format-icons": {
			"1": "󰀫",
			"2": "󰂡",
			"3": "󰏿",
			"4": "󰏉",
			// "1": "󰪀",
			// "2": "󰪁",
			// "3": "󰪈",
			// "4": "󰪃",
		},
		"tooltip": false,
		"enable-bar-scroll": true,
		"persistent-workspaces": {
			"*": 4, // 4 workspaces by default on every monitor
		},
		"persistent-only": true,
	},
	"clock": {
		"format": "<span size='large'></span> {:%H:%M   <span size='large'>󰃭</span> %d %b}",
	},
	"memory": {
		"interval": 60,
		"format": "{}%<span size='medium'></span>",
		"tooltip-format": "{used:0.1f}G/{total:0.1f}G <span size='medium'></span>"
	},
	"cpu": {
		"interval": 60,
		"format": "{usage}%<span size='medium'></span>"
	},
	"pulseaudio": {
		"format": "<span size='large'>{icon}</span>",
		"format-icons": ["", "", "", ""],
		"format-muted": "",
		"tooltip-format": "{volume}% <span size='large'>{icon}</span>",
		"headphone": ""
	},
	"bluetooth": {
		"format-off": "<span size='large'>󰂲</span>",
		"format-on": "<span size='large'></span>",
		"format-connected": "<span size='large'>󰂱</span>",
		"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
	},
	"network": {
		"format-wifi": "<span size='large'>{icon}</span>",
		"tooltip-format": "{essid} ({signalStrength}%) {icon}",
		"format-icons": ["󰤟","󰤢","󰤥","󰤨"],
		"format-disconnected": "󰤫"
	},
  "battery": {
    "format": "{capacity}%<span size='large'>{icon}</span>",
		"format-icons": {
			"default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
		}
  },
}
